# nexus-llm env contract — every knob lives here; the stack must boot with an
# empty .env (compose defaults below). The env-var contract is the API: when
# adding a knob, give it a default in compose AND in llm18083-bridge/config.yaml
# AND document it here.

# ── stack ────────────────────────────────────────────────────────────────
STACK_NAME=nexus-llm
NETWORK_NAME=nexus-llm-net
# Pinned /24 — the box's default docker address pools are exhausted.
# nexus-stt uses 172.16.20/21/23, tts 22, ocr 24/25.
LLM_SUBNET=172.16.26.0/24
# Public host port. nexus-llm.leanwise.ai (Cloudflare tunnel ingress) targets
# this port — changing it means re-pointing the tunnel too.
LLM_GATEWAY_PORT=18083

# ── bridge swap policy (mirrored in llm18083-bridge/config.yaml) ─────────
LLM_DEFAULT_MODEL=Qwen3.8-27B-NVFP4
# false = the bridge boots holding NO engine; the first request cold-wakes.
# true = wakes LLM_DEFAULT_MODEL at boot (adds a ~2-4 min GPU burst at start).
LLM_WAKE_ON_BOOT=false
# KEEP 0 ON GB10. TIER1 (/sleep level=1) spills weights into the same unified
# 128 GB pool it freed and pins ~8 GB — only TIER2 (docker stop) returns memory.
LLM_MAX_TIER1=0
LLM_WAKE_TIMEOUT_S=900
# Idle-demote the awake engine after N quiet seconds. 0 disables.
LLM_IDLE_SLEEP_S=600

# ── shared engine env ────────────────────────────────────────────────────
LLM_CUDA_DEVICES=0
HF_TOKEN=
# Set to 1 once weights are in llm-engines/LLM_*/hf-cache — otherwise every
# wake makes an HF Hub metadata call that, if slow, wedges the whole bridge
# (the wake holds the swap lock). The engine compose reads HF_HUB_OFFLINE.
HF_HUB_OFFLINE=0

# ── LLM_Qwen3.8-27B-NVFP4 (engine #1) ────────────────────────────────────
LLM_QWEN38_MODEL=RedHatAI/Qwen3.8-27B-NVFP4
# Naming invariant: folder = service = container_name = served name = route key.
LLM_QWEN38_SERVED_NAME=Qwen3.8-27B-NVFP4
# Quant scheme is auto-read from the checkpoint (compressed-tensors).
LLM_QWEN38_IMAGE=vllm/vllm-openai:v0.25.0-aarch64
LLM_QWEN38_MAX_LEN=69632
LLM_QWEN38_MAX_SEQS=16
LLM_QWEN38_MAX_BATCHED_TOKENS=4096
# Generous ceiling ONLY — the 8 GiB KV pin below is the real budget. util x
# total profiling is non-deterministic on GB10 unified memory.
LLM_QWEN38_GPU_UTIL=0.40
LLM_QWEN38_KV_CACHE_BYTES=8589934592
# The sm_121-compiled NVFP4 MoE kernel (vLLM >= 0.25). NEVER marlin on this box.
LLM_QWEN38_MOE_BACKEND=flashinfer_b12x
LLM_QWEN38_CUTE_DSL_ARCH=sm_121a
LLM_QWEN38_TOOL_PARSER=qwen3_xml
LLM_QWEN38_REASONING_PARSER=qwen3
LLM_QWEN38_SLEEP_MODE=false
LLM_QWEN38_CPUS=12
LLM_QWEN38_OMP_THREADS=8
