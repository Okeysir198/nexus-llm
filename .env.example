# nexus-llm env contract — every knob lives here; the stack must boot with an
# empty .env (compose defaults below). The env-var contract is the API: when
# adding a knob, give it a default in compose AND in llm18083-bridge/config.yaml
# AND document it here.

# ── stack ────────────────────────────────────────────────────────────────
STACK_NAME=nexus-llm
NETWORK_NAME=nexus-llm-net
# Pinned /24 — the box's default docker address pools are exhausted.
# nexus-stt uses 172.16.20/21/23, tts 22, ocr 24/25.
LLM_SUBNET=172.16.26.0/24
# Public host port. nexus-llm.leanwise.ai (Cloudflare tunnel ingress) targets
# this port — changing it means re-pointing the tunnel too.
LLM_GATEWAY_PORT=18083

# ── bridge swap policy (mirrored in llm18083-bridge/config.yaml) ─────────
LLM_DEFAULT_MODEL=LFM2.5-8B-A1B
# false = the bridge boots holding NO engine; the first request cold-wakes.
# true = wakes LLM_DEFAULT_MODEL at boot (adds a ~2-4 min GPU burst at start).
LLM_WAKE_ON_BOOT=false
# KEEP 0 ON GB10. TIER1 (/sleep level=1) spills weights into the same unified
# 128 GB pool it freed and pins ~8 GB — only TIER2 (docker stop) returns memory.
LLM_MAX_TIER1=0
LLM_WAKE_TIMEOUT_S=900
# Idle-demote the awake engine after N quiet seconds. 0 disables.
LLM_IDLE_SLEEP_S=600

# ── shared engine env ────────────────────────────────────────────────────
LLM_CUDA_DEVICES=0
HF_TOKEN=
# Set to 1 once weights are in llm-engines/LLM_*/hf-cache — otherwise every
# wake makes an HF Hub metadata call that, if slow, wedges the whole bridge
# (the wake holds the swap lock). The engine compose reads HF_HUB_OFFLINE.
HF_HUB_OFFLINE=0

# ── LLM_Qwen3.8-27B-NVFP4 (engine #1) ────────────────────────────────────
# Local dir served via the /models mount. To re-download: hf download RedHatAI/Qwen3.8-27B-NVFP4 --local-dir llm-engines/LLM_Qwen3.8-27B-NVFP4/hf-cache
LLM_QWEN38_MODEL=/models
# Naming invariant: folder = service = container_name = served name = route key.
LLM_QWEN38_SERVED_NAME=Qwen3.8-27B-NVFP4
# Quant scheme is auto-read from the checkpoint (compressed-tensors).
LLM_QWEN38_IMAGE=vllm/vllm-openai:v0.25.0-aarch64
LLM_QWEN38_MAX_LEN=69632
LLM_QWEN38_MAX_SEQS=16
LLM_QWEN38_MAX_BATCHED_TOKENS=4096
# Generous ceiling ONLY — the 8 GiB KV pin below is the real budget. util x
# total profiling is non-deterministic on GB10 unified memory.
LLM_QWEN38_GPU_UTIL=0.40
LLM_QWEN38_KV_CACHE_BYTES=8589934592
# The sm_121-compiled NVFP4 MoE kernel (vLLM >= 0.25). NEVER marlin on this box.
LLM_QWEN38_MOE_BACKEND=flashinfer_b12x
LLM_QWEN38_CUTE_DSL_ARCH=sm_121a
LLM_QWEN38_TOOL_PARSER=qwen3_xml
LLM_QWEN38_REASONING_PARSER=qwen3
LLM_QWEN38_SLEEP_MODE=false
LLM_QWEN38_CPUS=12
LLM_QWEN38_OMP_THREADS=8

# ── LLM_Ternary-Bonsai-2-27B (engine #3, llama.cpp PrismML fork) ─────────
# Quant A/B: PTQ1_0 (5.95 GB, 1.72 bpw) vs PQ2_0 (7.21 GB, 2.13 bpw).
# Switching quants = container recreate (one route per container invariant).
LLM_BONSAI_SERVED_NAME=Ternary-Bonsai-2-27B
LLM_BONSAI_QUANT=Ternary-Bonsai-2-27B-PTQ1_0.gguf
LLM_BONSAI_IMAGE=nexus-llm-bonsai-runtime:latest
LLM_BONSAI_NGL=99
LLM_BONSAI_CTX=65536
LLM_BONSAI_N_PREDICT=16384
LLM_BONSAI_KV_TYPE=q8_0
LLM_BONSAI_PARALLEL=4
LLM_BONSAI_SLEEP_MODE=false
LLM_BONSAI_CPUS=8

# ── LLM_LFM2.5-8B-A1B (engine #4, Liquid flagship) ───────────────────────
LLM_LFM_SERVED_NAME=LFM2.5-8B-A1B
LLM_LFM_MAX_LEN=128000
LLM_LFM_MAX_SEQS=24
LLM_LFM_KV_CACHE_BYTES=8589934592
LLM_LFM_GPU_UTIL=0.40
LLM_LFM_TOOL_PARSER=lfm2
LLM_LFM_SLEEP_MODE=false
LLM_LFM_CPUS=12
LLM_LFM_OMP_THREADS=8
LLM_LFM_HF_OFFLINE=1
LLM_LFM_KV_CACHE_BYTES=4294967296

# ── LLM_Qwen3.6-35B-A3B-NVFP4-B12X (engine #4, migrated from setup18083_llm) ─
# Unsloth requant (FP8 attn + NVFP4 MoE). Weights in the migrated hub-style
# cache; served via repo id with HF_HUB_OFFLINE=1.
LLM_QWEN36_SERVED_NAME=Qwen3.6-35B-A3B-NVFP4-B12X
LLM_QWEN36_MAX_LEN=131072
LLM_QWEN36_MAX_SEQS=16
LLM_QWEN36_KV_CACHE_BYTES=4294967296
LLM_QWEN36_GPU_UTIL=0.40
LLM_QWEN36_MOE_BACKEND=flashinfer_b12x
LLM_QWEN36_TOOL_PARSER=qwen3_coder
LLM_QWEN36_REASONING_PARSER=qwen3
LLM_QWEN36_SLEEP_MODE=false
LLM_QWEN36_CPUS=12
LLM_QWEN36_OMP_THREADS=8
LLM_QWEN36_HF_OFFLINE=1

# ── LLM_Nemotron-3.5-Bolt-E4B (engine #5, NVIDIA Bolt E4B, Gemma-4 base) ──
# BF16 checkpoint served with on-the-fly FP8 per-tensor (BF16 measured ~40%
# slower; LLM_BOLT_QUANT has no "off" value — see BENCHMARKS.md).
# Text-only (image/video/audio limits 0). 64K context is the card's limit.
LLM_BOLT_SERVED_NAME=Nemotron-3.5-Bolt-E4B
LLM_BOLT_IMAGE=vllm/vllm-openai:v0.32.0
LLM_BOLT_QUANT=fp8_per_tensor
LLM_BOLT_MAX_LEN=65536
LLM_BOLT_MAX_SEQS=24
LLM_BOLT_MAX_BATCHED_TOKENS=8192
LLM_BOLT_GPU_UTIL=0.20
LLM_BOLT_KV_CACHE_BYTES=4294967296
LLM_BOLT_TOOL_PARSER=gemma4
LLM_BOLT_REASONING_PARSER=gemma4
LLM_BOLT_SPEC_TOKENS=4
LLM_BOLT_SLEEP_MODE=false
LLM_BOLT_CPUS=12
LLM_BOLT_OMP_THREADS=8
LLM_BOLT_HF_OFFLINE=1
