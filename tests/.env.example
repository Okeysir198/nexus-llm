# Test-side .env. Copy to .env (gitignored). Independent of the stack-level
# services/llm_stack/.env — only the test client reads this.

# ── Gateway endpoint ───────────────────────────────────────────────────────
VLLM_PORT=18083                          # matches the repo-root .env LLM_GATEWAY_PORT
VLLM_MODEL=Qwen3.8-27B-NVFP4             # bridge route key under test

# ── Test knobs ─────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING                        # DEBUG / INFO / WARNING / ERROR
# CONC=10                                # concurrency for 03_concurrent.py
# TARGET=vllm                            # vllm | openai | groq | nvidia | zai | openrouter | huggingface | cerebras

# ── Cloud comparison providers (optional — only needed for non-vllm targets) ─
OPENAI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
CEREBRAS_API_KEY=
